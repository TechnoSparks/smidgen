# Dayfox (converted from Vim colorscheme)
color-link default "#3d2b5a,#f6f2ee"
color-link comment "#534c45,#f6f2ee"
color-link identifier "#2848a9,#f6f2ee"
color-link constant "#ac5402,#f6f2ee"
color-link constant.string "#396847,#f6f2ee"
color-link constant.string.char "#396847,#f6f2ee"
color-link statement "#b3434e,#f6f2ee"
color-link symbol.operator "#bfb6ae,#f6f2ee"
color-link preproc "#8452d5,#f6f2ee"
color-link type "#577f63,#f6f2ee"
color-link special "#488d93,#f6f2ee"
color-link underlined "underline #4863b6,#f6f2ee"
color-link error "bold #a5222f,#f6f2ee"
color-link todo "bold #b86e28,#f6f2ee"
color-link hlsearch "#f6f2ee,#b86e28"
color-link statusline "#3d2b5a,#534c45"
color-link tabbar "#534c45,#f6f2ee"
color-link indent-char "#534c45,#f6f2ee"
color-link line-number "#534c45,#f6f2ee"
color-link current-line-number "#3d2b5a,#f6f2ee"
color-link diff-added "#396847"
color-link diff-modified "#ac5402"
color-link diff-deleted "#a5222f"
color-link gutter-error "#a5222f,#f6f2ee"
color-link gutter-warning "#ac5402,#f6f2ee"
color-link cursor-line "#e7d2be"
color-link color-column "#e7d2be"
color-link type.extended "default"
color-link symbol.tag "#488d93,#f6f2ee"
color-link match-brace "#3d2b5a,#534c45"
color-link tab-error "#a5222f"
color-link trailingws "#a5222f"